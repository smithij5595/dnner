# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Models (per agent; defaults shown) ----------------------------------------
MODEL_ORCHESTRATOR=gpt-4o-mini
MODEL_PROFILE_UPDATER=gpt-4o-mini
MODEL_GROCERY_AGENT=gpt-4o-mini
MODEL_FOOD_QA=gpt-4o-mini
MODEL_INTAKE_AGENT=gpt-4o-mini
MODEL_RESPONSE_COMPOSER=gpt-4o-mini
MODEL_MEAL_ADVISOR=gpt-4o
MODEL_MEAL_PLANNER=gpt-4o
MODEL_CONSTRAINT_CHECKER=gpt-4o

# --- Scenario clock (scripts/run_scenarios.py only; the app always uses the real time) ---
# Monday used to resolve scenario shorthand like "Thu 8:15pm" (default: the upcoming Monday)
# WEEK_START=2026-11-09
# Default time for scenarios without a "now" (default: Wed 4:30pm). ISO or shorthand like "Thu 8:15pm"
# NOW_OVERRIDE=2026-11-11T16:30
HOME_TZ=America/Los_Angeles

# --- Prompt version: v1 (baseline) | v2 (adds guardrails) ----------------------
PROMPT_VERSION=v1

# --- Failure injection (all false = healthy baseline) --------------------------
INJECT_IGNORES_BUSY_NIGHTS=false
INJECT_CONSTRAINT_DRIFT=false
INJECT_GROCERY_SCALING_BUG=false
INJECT_HALLUCINATED_RECIPE=false
INJECT_ALLERGEN_MISS=false
INJECT_ROUTER_OVERCALL=false
INJECT_ROUTER_MISCLASSIFY=false
INJECT_FORGETFUL_ADVISOR=false
INJECT_OVERCONFIDENT_FOOD_QA=false
